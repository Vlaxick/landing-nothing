section.c-hero(aria-labelledby='hero-title')
  picture.c-hero__picture
    source(
      media='(min-width: 1260px)',
      type='image/avif',
      srcset='/src/assets/images/generated/hero-1260.avif 1260w, /src/assets/images/generated/hero-2520.avif 2520w',
      sizes='100vw'
    )
    source(
      media='(min-width: 744px)',
      type='image/avif',
      srcset='/src/assets/images/generated/hero-tablet-744.avif 744w, /src/assets/images/generated/hero-tablet-1488.avif 1488w',
      sizes='100vw'
    )
    source(
      type='image/avif',
      srcset='/src/assets/images/generated/hero-mobile-320.avif 320w, /src/assets/images/generated/hero-mobile-640.avif 640w',
      sizes='100vw'
    )
    source(
      media='(min-width: 1260px)',
      type='image/webp',
      srcset='/src/assets/images/generated/hero-1260.webp 1260w, /src/assets/images/generated/hero-2520.webp 2520w',
      sizes='100vw'
    )
    source(
      media='(min-width: 744px)',
      type='image/webp',
      srcset='/src/assets/images/generated/hero-tablet-744.webp 744w, /src/assets/images/generated/hero-tablet-1488.webp 1488w',
      sizes='100vw'
    )
    source(
      type='image/webp',
      srcset='/src/assets/images/generated/hero-mobile-320.webp 320w, /src/assets/images/generated/hero-mobile-640.webp 640w',
      sizes='100vw'
    )
    source(
      media='(min-width: 1260px)',
      srcset='/src/assets/images/generated/hero-1260.jpg 1260w, /src/assets/images/generated/hero-2520.jpg 2520w',
      sizes='100vw'
    )
    source(
      media='(min-width: 744px)',
      srcset='/src/assets/images/generated/hero-tablet-744.png 744w, /src/assets/images/generated/hero-tablet-1488.png 1488w',
      sizes='100vw'
    )
    img.c-hero__image(
      src='/src/assets/images/generated/hero-mobile-640.png',
      srcset='/src/assets/images/generated/hero-mobile-320.png 320w, /src/assets/images/generated/hero-mobile-640.png 640w',
      sizes='100vw',
      width='640',
      height='1136',
      alt='',
      fetchpriority='high',
      decoding='async'
    )
  .o-container.c-hero__content
    .o-grid.c-hero__grid
      h1#hero-title.c-hero__title Bring joy back to the everyday
